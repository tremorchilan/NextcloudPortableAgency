# ---------------------------------------------------------------------------
# {{EMPIRE_NAME}} — environment template.
#
# SERVICES ONLY REFERENCE PLACEHOLDERS. Real keys are registered with OneCLI
# ("Empire: Register Secret") and swapped in at runtime — they never touch
# this folder.
# ---------------------------------------------------------------------------

# OneCLI credential bootstrap (injected by Meta-Harness from the host's
# SecretStorage when you start the stack via the extension).
ONECLI_MASTER_KEY=GENERATE_ME
ONECLI_ADMIN_TOKEN=GENERATE_ME

# Host ports (change per Empire to avoid collisions; these are the only
# values the stack really needs to boot).
EMPIRE_DOCKGE_PORT=5001
EMPIRE_ONECLI_PORT=58080
EMPIRE_N8N_PORT=5678
EMPIRE_ESPO_PORT=8080
EMPIRE_ERP_PORT=8081
EMPIRE_NGINX_PORT=8082

# Placeholder service credentials — services use these names verbatim.
PLACEHOLDER_N8N_ADMIN_PASSWORD=
PLACEHOLDER_ESPO_ADMIN_PASSWORD=
PLACEHOLDER_ERP_ADMIN_PASSWORD=
PLACEHOLDER_HERMES_API_KEY=
PLACEHOLDER_OPENFANG_API_KEY=
PLACEHOLDER_OPENAI_API_KEY=
PLACEHOLDER_MAILGUN_API_KEY=
